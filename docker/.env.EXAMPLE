# Postgres setup
POSTGRES_VERSION=14.5 # version of postgres
POSTGRES_DB=entirety
POSTGRES_USER=entirety
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=entirety-db # postgres host (if in the same docker network: name of postgres service)

# Entirety Setup
ENTIRETY_PORT=8000 # port where entirety is reachable (via nginx)
ENTIRETY_VERSION=development # version of entirety

# Application Load
ENTITIES_LOAD=True
DEVICES_LOAD=True
NOTIFICATIONS_LOAD=True
SEMANTICS_LOAD=True

# Django
DJANGO_SECRET_KEY=<random passphrase with at minimum 32 characters length>
DJANGO_DEBUG=False

# JS/SCSS compression
COMPRESS_ENABLED=True

# LOGGING
LOKI_ENABLE=False
LOKI_HOST=localhost
LOKI_LEVEL=DEBUG
LOKI_PORT=3100
LOKI_TIMEOUT=0.5
LOKI_PROTOCOL=http
LOKI_SRC_HOST=entirety
LOKI_TIMEZONE=Europe/Berlin

# Authentication
LOCAL_AUTH=False
# OIDC Settings --> set LOCAL_AUTH=False
OIDC_LOGIN_URL=/oidc/authenticate
#OIDC_LOGIN_REDIRECT_URL="http://localhost/oidc/callback/"
OIDC_LOGIN_REDIRECT_URL=/oidc/callback/
OIDC_LOGOUT_REDIRECT_URL=/
OIDC_OP_AUTHORIZATION_ENDPOINT=https:/keycloak.de/realms/EBC-Dev/protocol/openid-connect/auth
OIDC_OP_JWKS_ENDPOINT=https:/keycloak.de/realms/EBC-Dev/protocol/openid-connect/certs
OIDC_OP_TOKEN_ENDPOINT=https:/keycloak.de/realms/EBC-Dev/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https:/keycloak.de/realms/EBC-Dev/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=https:/keycloak.de/realms/EBC-Dev/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=entirety
OIDC_RP_CLIENT_SECRET=
OIDC_SUPER_ADMIN_ROLE=super_admin
OIDC_SERVER_ADMIN_ROLE=server_admin
OIDC_PROJECT_ADMIN_ROLE=project_admin
OIDC_USER_ROLE=user
OIDC_TOKEN_ROLE_PATH="$.entirety.roles"
LOGIN_URL=/
LOGIN_REDIRECT_URL=/
LOGOUT_REDIRECT_URL=/

# Link to the FIWARE components; FQDN, IP address and port, or docker internal routes
CB_URL="http:/localhost:1026"
IOTA_URL="http:/localhost:4041"
QL_URL="http:/localhost:8668"
REALM="EBC-Dev"
KEYCLOAK_HOST="https:/keycloak.de/"
KEYCLOAK_CLIENT_ID=entirety
KEYCLOAK_CLIENT_SECRET=

# CSRF
CSRF_TRUSTED_ORIGINS=["https://local-deployment.de","https:/keycloak.de"]
ALLOWED_HOSTS = ["local-deployment.de"]

# NGINX
WEB_HOST=local-deployment.de
NGINX_VERSION=1.21.3

# Static files location
STATIC_ROOT=/var/entirety/static/
MEDIA_ROOT=/var/entirety/media/
